{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "Allows for emissive textures to be quickly added as an overlay on both Block and Item models, as well as changing the render layers of blocks.",
  "authors": [
    "Lufurrius",
    "Luna/AViewFromTheTop"
  ],
  "contributors": [
  ],
  "contact": {
    "homepage": "${mod_url}",
    "sources": "${source_url}",
    "issues": "${issues_url}"
  },
  "license": "${mod_license}",
  "icon": "assets/glowtone/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "net.frozenblock.glowtone.GlowtoneFabricClient"
    ],
    "fabric-datagen": [
      "net.frozenblock.glowtone.data.GTDataGenerator"
    ],
    "sodium:config_api_user": [
      "net.frozenblock.glowtone.config.sodium.GlowtoneSodiumConfig"
    ]
  },
  "mixins": [
    "glowtone.mixins.json",
    "glowtone.fabric.mixins.json"
  ],
  "accessWidener": "glowtone.classtweaker",
  "depends": {
    "frozenlib": "${frozenlib_version}",
    "fabric-api": "*",
    "fabricloader": "${fabric_loader_version}",
    "minecraft": "${minecraft_version}"
  },
  "suggests": {
    "cloth-config": "*"
  },
  "custom": {
    "modmenu": {
      "links": {
        "X": "https://x.com/FB_Oasis",
        "Bluesky": "https://bsky.app/profile/frozenblock.bsky.social",
        "modmenu.discord": "https://discord.gg/frozenblock",
        "modmenu.modrinth": "https://modrinth.com/organization/frozenblock",
        "modmenu.youtube": "https://www.youtube.com/@frozenblockmoddingoasismod",
        "modmenu.kofi": "https://ko-fi.com/frozenblock"
      },
      "badges": [
        "frozenblock"
      ]
    }
  }
}
